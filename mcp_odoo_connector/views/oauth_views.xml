<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mcp_oauth_client_view_tree" model="ir.ui.view">
        <field name="name">mcp.oauth.client.tree</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="approved"/>
                <field name="allow_write"/>
                <field name="created_via_dcr"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="mcp_oauth_client_view_form" model="ir.ui.view">
        <field name="name">mcp.oauth.client.form</field>
        <field name="model">mcp.oauth.client</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id" readonly="1"/>
                            <field name="token_endpoint_auth_method"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="approved"/>
                            <field name="allow_write"/>
                            <field name="created_via_dcr"/>
                        </group>
                    </group>
                    <group string="Redirect URIs">
                        <field name="redirect_uris" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Tokens">
                            <field name="token_ids" readonly="1">
                                <tree>
                                    <field name="user_id"/>
                                    <field name="expires_at"/>
                                    <field name="last_used_at"/>
                                    <field name="revoked"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_oauth_client_action" model="ir.actions.act_window">
        <field name="name">OAuth Clients</field>
        <field name="res_model">mcp.oauth.client</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="mcp_oauth_token_view_tree" model="ir.ui.view">
        <field name="name">mcp.oauth.token.tree</field>
        <field name="model">mcp.oauth.token</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="client_id"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="last_used_at"/>
                <field name="last_used_ip"/>
                <field name="revoked"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"
                        invisible="revoked"/>
            </tree>
        </field>
    </record>

    <record id="mcp_oauth_token_action" model="ir.actions.act_window">
        <field name="name">OAuth Sessions</field>
        <field name="res_model">mcp.oauth.token</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
