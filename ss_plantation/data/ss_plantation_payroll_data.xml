<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="salary_rule_harvest_pay" model="hr.salary.rule">
        <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.ALW'), ref('l10n_id_hr_payroll.l10n_id_income_parent_category')])]"/>
        <field name="name">Harvest Pay (Premi Panen)</field>
        <field name="code">SS_HARVEST</field>
        <field name="sequence">21</field>
        <field name="condition_select">property_input</field>
        <field name="input_usage_payslip" eval="True"/>
        <field name="amount_select">property_input</field>
        <field name="appears_on_payslip">non_zero</field>
        <field name="input_section" ref="l10n_id_hr_payroll.l10n_id_allowances_salary_rule_section"/>
        <field name="input_usage_employee" eval="False"/>
        <field name="input_default_value" eval="0.0"/>
        <field name="struct_ids" eval="[(6, 0, [
            ref('l10n_id_hr_payroll.hr_payroll_structure_id_employee_salary'),
        ])]"/>
        <field name="country_id" ref="base.id"/>
    </record>
</odoo>
