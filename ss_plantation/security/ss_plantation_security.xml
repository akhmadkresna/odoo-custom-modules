<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_plantation" model="res.groups.privilege">
        <field name="name">Plantation</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_plantation_user" model="res.groups">
        <field name="name">Clerk</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_plantation"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('stock.group_stock_user'))]"/>
        <field name="comment">Records field activities, harvest tallies and transport notes.</field>
    </record>

    <record id="group_plantation_weighbridge" model="res.groups">
        <field name="name">Weighbridge Operator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_plantation"/>
        <field name="implied_ids" eval="[Command.link(ref('group_plantation_user')), Command.link(ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Issues and confirms weigh tickets.</field>
    </record>

    <record id="group_plantation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_plantation"/>
        <field name="implied_ids" eval="[Command.link(ref('group_plantation_weighbridge'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Manages master data, prices, pay schemes and can correct confirmed tickets.</field>
    </record>

    <!-- Feature switches, set from Settings. They only show or hide menus and buttons. -->
    <record id="group_ss_feature_payroll" model="res.groups">
        <field name="name">Plantation: Harvest Pay</field>
    </record>
    <record id="group_ss_feature_asset" model="res.groups">
        <field name="name">Plantation: Mature Assets</field>
    </record>
    <record id="group_ss_feature_mill" model="res.groups">
        <field name="name">Plantation: Own Mill</field>
    </record>
</odoo>
