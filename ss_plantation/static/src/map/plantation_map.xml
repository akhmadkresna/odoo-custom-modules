<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ss_plantation.PlantationMap">
        <div class="o_action o_ss_plantation_map d-flex flex-column h-100">
            <div class="o_ss_map_bar d-flex flex-wrap align-items-center gap-3 p-2 border-bottom bg-view">
                <label class="d-flex align-items-center gap-1 mb-0">
                    Colour blocks by
                    <select class="form-select form-select-sm w-auto" t-on-change="this.onColorByChange">
                        <option value="stage" t-att-selected="this.state.colorBy === 'stage'">Stage</option>
                        <option value="yield" t-att-selected="this.state.colorBy === 'yield'">Yield, last 30 days</option>
                    </select>
                </label>
                <label class="mb-0"><input type="checkbox" checked="checked" t-on-change="(ev) => this.onToggleLayer('estates', ev)"/> Estates</label>
                <label class="mb-0"><input type="checkbox" checked="checked" t-on-change="(ev) => this.onToggleLayer('divisions', ev)"/> Divisions</label>
                <label class="mb-0"><input type="checkbox" checked="checked" t-on-change="(ev) => this.onToggleLayer('blocks', ev)"/> Blocks (<t t-out="this.state.counts.blocks"/>)</label>
                <label class="mb-0"><input type="checkbox" checked="checked" t-on-change="(ev) => this.onToggleLayer('landmarks', ev)"/> Landmarks (<t t-out="this.state.counts.landmarks"/>)</label>
                <button type="button" class="btn btn-sm btn-secondary" t-on-click="this.onFit">Fit to data</button>
                <span class="d-flex align-items-center gap-2 ms-auto small">
                    <t t-if="this.state.colorBy === 'stage'">
                        <span t-foreach="Object.entries(this.stageColors)" t-as="entry" t-key="entry[0]" class="d-flex align-items-center gap-1">
                            <i class="o_ss_map_swatch" t-att-style="'background:' + entry[1]"/><t t-out="entry[0]"/>
                        </span>
                    </t>
                    <t t-else="">
                        <span t-foreach="this.yieldBands" t-as="band" t-key="band.label" class="d-flex align-items-center gap-1">
                            <i class="o_ss_map_swatch" t-att-style="'background:' + band.color"/><t t-out="band.label"/>
                        </span>
                    </t>
                </span>
            </div>
            <div class="o_ss_map_canvas flex-grow-1" t-ref="this.mapRef"/>
        </div>
    </t>
</templates>
