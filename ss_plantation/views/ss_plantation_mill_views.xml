<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_view_form_inherit_ss_plantation" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.ss.plantation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <page name="components" position="after">
                <page string="Extraction Rates" name="ss_extraction" groups="ss_plantation.group_ss_feature_mill">
                    <group>
                        <group>
                            <field name="ss_ffb_kg"/>
                            <field name="ss_cpo_kg"/>
                            <field name="ss_kernel_kg"/>
                        </group>
                        <group>
                            <field name="ss_oer"/>
                            <field name="ss_ker"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="mrp_production_view_pivot_ss_plantation" model="ir.ui.view">
        <field name="name">mrp.production.pivot.ss.plantation</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Extraction Rates">
                <field name="date_start" type="row" interval="month"/>
                <field name="ss_ffb_kg" type="measure"/>
                <field name="ss_cpo_kg" type="measure"/>
                <field name="ss_kernel_kg" type="measure"/>
                <field name="ss_oer" type="measure"/>
                <field name="ss_ker" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="mrp_production_ss_extraction_action" model="ir.actions.act_window">
        <field name="name">Extraction Rates</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('mrp_production_view_pivot_ss_plantation')}),
        ]"/>
    </record>

    <record id="res_config_settings_view_form_ss_plantation" model="ir.ui.view">
        <field name="name">res.config.settings.form.ss.plantation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Plantation" name="ss_plantation" groups="ss_plantation.group_plantation_manager">
                    <block title="Harvest and Weighbridge" name="ss_harvest_settings">
                        <setting string="Products" help="Products used by weigh tickets and the mill">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="ss_ffb_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_ffb_product_id"/>
                                </div>
                                <div class="row">
                                    <label for="ss_cpo_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_cpo_product_id"/>
                                </div>
                                <div class="row">
                                    <label for="ss_kernel_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_kernel_product_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Locations" help="Warehouse and virtual locations used for stock moves">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="ss_warehouse_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_warehouse_id"/>
                                </div>
                                <div class="row">
                                    <label for="ss_estate_location_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_estate_location_id"/>
                                </div>
                                <div class="row">
                                    <label for="ss_consumption_location_id" class="col-lg-4 o_light_label"/>
                                    <field name="ss_consumption_location_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Freshness Limit" help="Hours allowed between harvest and weighing before a ticket is flagged">
                            <field name="ss_freshness_hours"/>
                        </setting>
                    </block>
                    <block title="Optional Features" name="ss_feature_settings">
                        <setting string="Harvest Pay" help="Pay schemes and harvest pay on payslips">
                            <field name="group_ss_feature_payroll"/>
                        </setting>
                        <setting string="Mature Plantation Assets" help="Capitalise mature blocks as depreciable assets">
                            <field name="group_ss_feature_asset"/>
                        </setting>
                        <setting string="Own Mill" help="Extraction rates for own mill manufacturing orders">
                            <field name="group_ss_feature_mill"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="ss_plantation_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'ss_plantation', 'bin_size': False}</field>
    </record>

    <record id="hr_payslip_view_form_inherit_ss_plantation" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.ss.plantation</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <button name="action_print_payslip" position="before">
                <button name="action_ss_add_harvest_pay" type="object" string="Add Harvest Pay"
                        invisible="state not in ('draft', 'verify')" groups="ss_plantation.group_ss_feature_payroll"/>
            </button>
        </field>
    </record>

    <record id="ss_plantation_block_asset_wizard_view_form" model="ir.ui.view">
        <field name="name">ss.plantation.block.asset.wizard.form</field>
        <field name="model">ss.plantation.block.asset.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="block_id"/>
                        <field name="name"/>
                        <field name="acquisition_date"/>
                        <field name="original_value"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="journal_id"/>
                        <field name="account_asset_id"/>
                        <field name="counterpart_account_id"/>
                    </group>
                </group>
                <div class="text-muted">
                    Creates a journal entry moving the development cost from the counterpart account to
                    the asset account, and a draft asset linked to it. Validate the asset to start depreciation.
                </div>
                <footer>
                    <button name="action_create_asset" type="object" string="Create Asset" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ss_plantation_block_asset_wizard_action" model="ir.actions.act_window">
        <field name="name">Capitalise Block</field>
        <field name="res_model">ss.plantation.block.asset.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
